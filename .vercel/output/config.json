{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/access-db/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/submit-contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/broadcast/?$",
			"dest": "_render"
		},
		{
			"src": "^/catancounter/?$",
			"dest": "_render"
		},
		{
			"src": "^/create-account-p4A7EA1/?$",
			"dest": "_render"
		},
		{
			"src": "^/listen/?$",
			"dest": "_render"
		},
		{
			"src": "^/planner/?$",
			"dest": "_render"
		},
		{
			"src": "^/wordlebot/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}