---
import Layout from "../layouts/plannerLayout.astro";
import "../styles/planner.css";
import DisplayCategories from "@/components/planner/displayCategories.tsx";
import Login from "@/components/planner/login.tsx";
import type { UserData } from "@/lib/types";

//call API to fetch user data
let user: UserData | undefined;

//await loginUser(userName, password);
---

<Layout title="RK Planner" description="Chocolate">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold text-gray-400 my-8 text-center">
            <Login client:load />
        </h1>
        <DisplayCategories client:load userData={user} />
    </div>
</Layout>

<!-- Script that calls the API to save user data. Must be a
     global script so displayCategories.tsx can see it. -->
<script>
    // Define the save function globally so the React component can call it
    window.saveUserData = async (newUserData) => {
        const userName = localStorage.getItem("userName");
        if (!userName) {
            console.error("No user logged in");
            return;
        }
        try {
            const response = await fetch("/api/access-db", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    action: "save",
                    name: userName,
                    userData: newUserData,
                }),
            });
            const result = await response.json();
            if (response.ok) {
                console.log("Save successful:", result.message);
            } else {
                console.error("Save failed:", result.error);
            }
        } catch (error) {
            console.error("Error saving:", error);
        }
    };
    window.doLogin = async (name, password) => {
        try {
            const response = await fetch(
                new URL(
                    "/api/access-db",
                    import.meta.env.SITE || "http://localhost:4321",
                ),
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify({
                        action: "login",
                        name: name,
                        password: password,
                    }),
                },
            );

            const data = await response.json();

            if (response.ok) {
                console.log("Login successful for", name);
                // Store user data and name for persistence
                localStorage.setItem("user", JSON.stringify(data));
                localStorage.setItem("userName", name);
                // Reload to render with user data
                window.location.reload();
            } else {
                console.error("Login failed:", data.error);
            }
        } catch (error) {
            console.error("Error during login:", error);
        }
    };
</script>
