---
//main imports
import Layout from "@/layouts/projectLayout.astro";
import "@/styles/global.css";
import defineConfig from "astro.config.mjs";
// Component Imports
import ProjectCard from "@/components/projectCard";
---

<Layout title="RK Projects" description="Ruffles Kerman Projects">
	<div class="container mx-auto px-4">
		<div class="text-center py-20">
			<h1 class="text-4xl md:text-6xl font-bold text-gray-400 mb-6">
				More Projects
			</h1>
			<p class="text-xl text-gray-400 mb-1 max-w-2xl mx-auto">
				Here is where I am putting some of my favorite school projects
			</p>
		</div>

		<!-- Feature cards -->
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 py-16">
			<ProjectCard
				title="Mandlebrot"
				description="An implementation of the Mandlebrot set using WebGL, with a twist."
				href={defineConfig.base + "projects/mandlebrot"}
				buttonText="View"
			/>
			<ProjectCard
				title="Sorting Algorithm Visualiser"
				description="This project visualises how different sorting algorithms sort a list"
				href={defineConfig.base + "projects/sorting"}
				buttonText="View"
			/>
		</div>
	</div>
</Layout>
