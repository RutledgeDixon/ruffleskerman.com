---
//main imports
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
// Component Imports
import ProjectCard from "@/components/projectCard";
---

<Layout title="RK Projects" description="Ruffles Kerman Projects">
	<div class="container mx-auto px-4">
		<div class="text-center py-20">
			<h1 class="text-4xl md:text-6xl font-bold tracking-tight text-slate-50 mb-6">
				More Projects
			</h1>
			<p class="text-lg md:text-xl text-slate-300/80 mb-1 max-w-2xl mx-auto">
				Here is where I am putting some of my favorite school projects
			</p>
		</div>

		<!-- Feature cards -->
		<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 py-16">
			<ProjectCard
				title="Mandlebrot"
				description="An implementation of the Mandlebrot set using WebGL, with a twist."
				href="/projects/mandlebrot"
				buttonText="View"
			/>
			<ProjectCard
				title="Sorting Algorithm Visualiser"
				description="This project visualises how different sorting algorithms sort a list"
				href="/projects/sorting"
				buttonText="View"
			/>
			<ProjectCard
				title="Particles"
				description="An exploration of particle systems using Boid's Algorithm in WebGL."
				href="/projects/particles"
				buttonText="View"
			/>
			<ProjectCard
				title="🛠️ LeTour"
				description="Listen page - Software Engineering 2 final project... In progress! Meant for mobile."
				href={"https://letourv2-gwdxdcb6hngsebb2.northcentralus-01.azurewebsites.net/listen"}
				buttonText="Listen"
			/>
			<ProjectCard
				title="🛠️ LeTour"
				description="Broadcast page - Software Engineering 2 final project... In progress! Meant for mobile."
				href={"https://letourv2-gwdxdcb6hngsebb2.northcentralus-01.azurewebsites.net/broadcast"}
				buttonText="Broadcast"
			/>
		</div>
	</div>
</Layout>
