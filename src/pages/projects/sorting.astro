---
// Astro component for Sorting Visualization
---

<!doctype html>
<html>
    <style>
        /* global reset to avoid accidental scrollbars */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }
        html,
        body {
            height: 100%;
            margin: 0;
        }
        .main-container,
        #main-container {
            position: relative; /* contain absolute overlays */
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden; /* keep canvas contained */
            background: #222; /* fallback background while canvas loads */
        }

        #algorithm-select,
        #speed-select,
        #count-select {
            background: #444;
            border-radius: 5px;
            color: white;
            border: none;
        }

        #canvas-container {
            position: absolute;
            inset: 0; /* top:0; left:0; right:0; bottom:0 */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* make the canvas fit inside container while leaving a little margin */
        #canvas-container canvas {
            display: block;
            width: calc(100% - 24px);
            height: calc(100% - 24px);
            max-width: 100%;
            max-height: 100%;
        }

        /* top-right options overlay */
        #options {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 50;
            background: rgba(0, 0, 0, 0.5);
            color: white;
            padding: 10px 12px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
            display: flex;
            gap: 8px;
            align-items: center;
            font-family:
                system-ui,
                -apple-system,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial;
        }

        #options label,
        #options select {
            color: #fff;
        }

        /* bottom centered start/play button overlay */
        /* bottom centered control group (two buttons side-by-side) */
        #bottom-controls {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 60;
            display: flex;
            gap: 12px;
            align-items: center;
        }

        #bottom-controls button {
            padding: 10px 16px;
            border: none;
            background: rgba(255, 255, 255, 0.92);
            color: #222;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
        }

        #bottom-controls button:hover {
            transform: translateY(-2px);
        }

        /* small-screen adjustments */
        @media (max-width: 600px) {
            #options {
                right: 10px;
                top: 10px;
                padding: 8px;
                gap: 6px;
            }
            #bottom-controls {
                gap: 8px;
                bottom: 16px;
            }
            #bottom-controls button {
                padding: 8px 12px;
                font-size: 14px;
            }
        }
    </style>

    <meta charset="utf-8" />
    <title>Algorithm Visualisation</title>

    <body onload="main()">
        <script type="text/javascript" src="/scripts/common/webgl-utils.js"
        ></script>
        <script type="text/javascript" src="/scripts/common/webgl-debug.js"
        ></script>
        <script type="text/javascript" src="/scripts/common/cuon-utils-letu.js"
        ></script>
        <script type="text/javascript" src="/scripts/common/cuon-matrix.js"
        ></script>
        <script type="text/javascript" src="/scripts/common/initShaders.js"
        ></script>
        <script type="text/javascript" src="/scripts/common/MV.js"></script>
        <script type="text/javascript" src="/scripts/sorting.js"></script>
        <script type="text/javascript" src="/scripts/sortingAlgorithms.js"
        ></script>

        <!-- Shaders are now loaded from external files in JS: /scripts/shaders/sorting-vertex.glsl and /scripts/shaders/sorting-fragment.glsl -->

        <div id="main-container">
            <div id="options">
                <label id="select-label" for="algorithm-select"
                    >Select Sorting Algorithm</label
                >
                <select
                    id="algorithm-select"
                    onchange="changeAlgorithm(this.value)"
                >
                    <option value="bubble">Bubble Sort</option>
                    <option value="selection">Selection Sort</option>
                    <option value="insertion">Insertion Sort</option>
                    <option value="merge">Merge Sort</option>
                    <option value="quick">Quick Sort</option>
                    <option value="heap">Heap Sort</option>
                    <option value="shell">Shell Sort</option>
                    <option value="bogo">Bogo Sort</option>
                </select>
                <label id="speed-label" for="speed-select">Select Speed</label>
                <select id="speed-select" onchange="changeSpeed(this.value)">
                    <option value="slow">Slow</option>
                    <option value="medium" selected>Medium</option>
                    <option value="fast">Fast</option>
                </select>
                <label id="count-label" for="count-select">Count</label>
                <input
                    type="number"
                    id="count-select"
                    value="10"
                    min="2"
                    max="50"
                    onchange="if(this.value < 2) this.value = 2; if(this.value > 50) this.value = 50; changeCount(this.value)"
                />
            </div>
            <div id="canvas-container">
                <canvas id="webgl" width="1024" height="1024">
                    Oops ... your browser doesn't support the HTML5 canvas
                    element
                </canvas>
                <div id="bottom-controls">
                    <button id="start-button" onclick="toggleSorting()"
                        >Start</button
                    >
                    <button id="randomize-button" onclick="randomizeArray()"
                        >Randomize</button
                    >
                </div>
            </div>
        </div>
    </body>
</html>
