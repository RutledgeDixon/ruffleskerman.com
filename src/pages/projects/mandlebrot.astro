<!doctype html>
<html>
    <style>
        body,
        html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        canvas {
            width: 100vw;
            height: 100vh;
            display: block;
        }
        #info {
            position: fixed;
            bottom: 20px;
            left: 20px;
            color: white;
            font-family: Arial, sans-serif;
            font-size: 16px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
            z-index: 1000;
        }
    </style>

    <meta charset="utf-8" />
    <title>Dixon Mandlebrot</title>


    <script type="text/javascript" src="/scripts/common/webgl-utils.js"
    ></script>
    <script
        type="text/javascript"
        src="/scripts/common/initShadersWithObjects.js"></script>
    <script type="text/javascript" src="/scripts/common/MV.js"></script>
    <script type="text/javascript" src="/scripts/mandlebrot.js"></script>

    <body>
        <canvas id="gl-canvas" width="1000" height="1000">
            Oops ... your browser doesn't support the HTML5 canvas element
        </canvas>
        <canvas
            id="crosshair-canvas"
            width="1000"
            height="1000"
            style="position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none;"
        ></canvas>
        <div id="info">
            <div id="Scale">Scale 0.01</div>
            <div id="Center">Center (0.0, 0.0)</div>
            <div>Scroll to zoom, drag to pan</div>
        </div>
    </body>
</html>
