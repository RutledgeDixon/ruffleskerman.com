---
//main imports
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
//variables
---

<Layout title="About" description="About">
    <p class="text-slate-500 text-sm italic m-4">
        This page is no longer linked from the site navigation, but it's still here
        for anyone with the direct link.
    </p>
    <div class="flex flex-col sm:flex-row justify-start gap-4 p-4">
        <div class="site-card p-7 flex-1">
            <h2 class="text-slate-50 font-semibold text-lg mb-2 tracking-tight">Education</h2>
            <p class="text-slate-300/80 whitespace-pre-line leading-relaxed">
                Bachelor of Science in Computer Science Engineering from
                Letourneau University. Minor in mathematics. GPA 4.0 - Graduation date: May 2026
            </p>
        </div>
        <div class="flex flex-col gap-4 flex-1">
            <div class="site-card p-7 flex-1">
                <h2 class="text-slate-50 font-semibold text-lg mb-2 tracking-tight">Experience</h2>
                <p class="text-slate-300/80 whitespace-pre-line leading-relaxed">
                    Software Development / IT Intern at Righteous Rides - Summer
                    2025 - Warrenton, MO - Developed web applications using
                    react and electron - Integrated databases and CRMs with APIs
                    - Wrote Python scripts to automate CRM management tasks -
                    Provided IT support for internal systems and server
                    infrastructure
                </p>
            </div>
            <div class="site-card p-7 flex-1">
                <h2 class="text-slate-50 font-semibold text-lg mb-2 tracking-tight">Hobbies</h2>
                <p class="text-slate-300/80 whitespace-pre-line leading-relaxed">
                    - Playing piano - Making tea - Swimming - Working on this
                    website - Spending time with family
                </p>
            </div>
        </div>
    </div>
</Layout>
