---
// Catan Card Counter - Converted to Astro

// TODO
// - add credit
// - make dice work with react components
// - add home button

import CatanPlayersContainer from '../components/catan/PlayersContainer.tsx';
import NumberOfPlayersButton from '../components/catan/NumberOfPlayersButton.tsx';
import '../styles/catan-players.css';

//variables
let numberOfPlayers = 4;
---

<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Catan Card Counter</title>
    <!-- Stylesheet -->
    <style>
        body {
            background-color: #464648;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            margin: 0;
            font-family: 'Exo 2', sans-serif;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        h1 {
            color: white;
            font-size: 3.5rem;
        }

        div.diceDiv {
            padding-bottom: 100px;
        }

        div.dice {
            background: white;
            color: #464648;
            float: left;
            width: 9%;
            padding-top: 2%;
            padding-bottom: 2%;
            margin-right: 1.1%;
            border-radius: 20px;
            text-align: center;
            font-family: 'Exo 2', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            transition: 0.2s;
        }

        div#dice12 {
            margin-right: 0%;
        }

        div.dice:hover {
            color: steelblue;
            box-shadow: 0px 0px 10px 1px steelblue;
        }



        .main-catan-center {
            display: flex;
            justify-content: center;   /* Center children horizontally */
            align-items: flex-start;   /* Align to top, or use center for vertical centering */
            width: 100%;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            div.dice {
                font-size: 2rem;
            }
            h1 {
                font-size: 2.5rem;
            }
            div#playerHands {
                width: 100%;
                float: none;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 10px;
            }
            
            div.dice {
                font-size: 1.5rem;
                width: 18%;
                margin-bottom: 10px;
            }
            
            div.diceDiv {
                padding-bottom: 20px;
            }
            
            h1 {
                font-size: 2rem;
            }
            
            #numButton {
                font-size: 0.4em;
                padding: 5px;
            }
        }
    </style>
  </head>
  <body>
    <div class="header">
        <h1>
            Catan Card Counter
        </h1>
        <NumberOfPlayersButton client:load />
    </div>

    <div class="diceDiv">
      <div class="dice" id="dice2">2</div>
      <div class="dice" id="dice3">3</div>
      <div class="dice" id="dice4">4</div>
      <div class="dice" id="dice5">5</div>
      <div class="dice" id="dice6">6</div>
      <div class="dice" id="dice8">8</div>
      <div class="dice" id="dice9">9</div>
      <div class="dice" id="dice10">10</div>
      <div class="dice" id="dice11">11</div>
      <div class="dice" id="dice12">12</div>
    </div>

    <!-- React Players Component -->
    <div class="main-catan-center">
        <CatanPlayersContainer client:load numberOfPlayers={numberOfPlayers} />
    </div>

    <!-- Load external script -->
    <script is:inline src="/scripts/catan-counter.js"></script>
    
  </body>
</html>