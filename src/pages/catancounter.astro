---
// Catan Card Counter - Converted to Astro

// TODO
// - add credit
// - make dice work with react components
// - add home button

import CatanPlayersContainer from '../components/catan/PlayersContainer.tsx';
import '../styles/catan-players.css';
---

<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Catan Card Counter</title>
    <!-- Stylesheet -->
    <style>
        body {
            background-color: #464648;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            margin: 0;
            font-family: 'Exo 2', sans-serif;
        }

        #theHideDiv {
            position: absolute;
            z-index: 2;
            height: 100%;
            width: 100%;
            display: none;
            margin-left: -20px;
            margin-top: -35px;
        }

        #theDiv {
            position: absolute;
            z-index: 3;
            top:-60%;
            width: 50%;
            left: 25%;
            padding: 2%;
            background: #464647;
            color: white;
            border-radius: 20px;
            box-shadow: 0px 0px 20px 1px black;
            text-align: center;
            transition: 0.5s;
        }

        #theDiv input {
            text-align: center;
            background: none;
            color: white;
            width: 30%;
            height: 20%;
            border: 2px solid steelblue;
            outline: none;
            margin-bottom: 15px;
            font-size: 2rem;
            border-radius: 30px;
            transition: 0.2s;
        }

        #theDiv input:hover {
            background: steelblue;
        }

        #theDiv input::-webkit-outer-spin-button,
        #theDiv input::-webkit-inner-spin-button {
            display: none;
        }

        #theDiv button {
            display: block;
            margin: auto;
            text-align: center;
            background: none;
            color: white;
            width: 30%;
            height: 20%;
            border: 2px solid steelblue;
            outline: none;
            font-size: 2rem;
            border-radius: 30px;
            transition: 0.2s;
        }

        #theDiv button:hover {
            background: steelblue;
        }

        #catanHeader {
            float: left;
        }

        h1.header {
            text-align: center;
            color: white;
            font-size: 3.5rem;
        }

        #numButton {
            background:  #464647;
            color: white;
            font-size: 0.5em;
            padding: 10px;
            border: 2px solid steelblue;
            border-radius: 15px;
            margin: auto;
            transition: 0.2s;
            float: right;
            outline: none;
        }

        #numButton:hover {
            background: steelblue;
            border: 2px solid steelblue;
        }

        #numButton::-moz-focus-inner {
            border: 0;
        }

        div.diceDiv {
            padding-bottom: 170px;
        }

        div.dice {
            background: white;
            color: #464648;
            float: left;
            width: 9%;
            padding-top: 2%;
            padding-bottom: 2%;
            margin-right: 1.1%;
            border-radius: 20px;
            text-align: center;
            font-family: 'Exo 2', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            transition: 0.2s;
        }

        div#dice12 {
            margin-right: 0%;
        }

        div.dice:hover {
            color: steelblue;
            box-shadow: 0px 0px 10px 1px steelblue;
        }



        /* Player Hand Section (Your Hand) */
        div#playerHands {
            float: left;
            width: 60%;
            text-align: center;
            background: white;
            border-radius: 20px;
            padding: 20px;
            margin-top: 20px;
        }

        div#playerHands h1 {
            color: black;
            margin-bottom: 20px;
        }

        .resourceDisplay {
            font-size: 2rem;
            font-weight: 700;
            color: black;
            margin-bottom: 10px;
        }

        .resourceDisplay span {
            color: steelblue;
            font-size: 1.5rem;
        }

        .deckButton {
            border: none;
            padding: 20px;
            margin: 10px;
            border-radius: 20px;
            background: steelblue;
            color: white;
            transition: 0.2s;
            font-size: 1.5rem;
            cursor: pointer;
        }

        .deckButton:hover {
            background: white;
            color: steelblue;
            border: 2px solid steelblue;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            div.dice {
                font-size: 2rem;
            }
            h1.header {
                font-size: 2.5rem;
            }
            div#playerHands {
                width: 100%;
                float: none;
            }
        }

        @media (max-width: 768px) {
            body {
                padding: 10px;
            }
            
            div.dice {
                font-size: 1.5rem;
                width: 18%;
                margin-bottom: 10px;
            }
            
            div.diceDiv {
                padding-bottom: 20px;
            }
            
            h1.header {
                font-size: 2rem;
            }
            
            #numButton {
                font-size: 0.4em;
                padding: 5px;
            }
        }
    </style>
  </head>
  <body>

    <div id="theHideDiv"></div>
    <div id="theDiv">
      <h1>How many people are playing? (Other than yourself, obviously)</h1>
      <input type="number" id="numPlayers" value="5" step="1">
      <button id="theButton2">Let's play!</button>
    </div>

    <h1 class="header"><a href="/" id="catanHeader"></a>Catan Card Counter<button id="numButton">Number of Players</button></h1>

    <div class="diceDiv">
      <div class="dice" id="dice2">2</div>
      <div class="dice" id="dice3">3</div>
      <div class="dice" id="dice4">4</div>
      <div class="dice" id="dice5">5</div>
      <div class="dice" id="dice6">6</div>
      <div class="dice" id="dice8">8</div>
      <div class="dice" id="dice9">9</div>
      <div class="dice" id="dice10">10</div>
      <div class="dice" id="dice11">11</div>
      <div class="dice" id="dice12">12</div>
    </div>

    <!-- React Players Component -->
    <CatanPlayersContainer client:load numberOfPlayers={6} />

    <div id="playerHands">
      <h1>Your Hand</h1>
      <div class="resourceDisplay">Brick: <span id="playerbrick">0</span></div>
      <div class="resourceDisplay">Lumber: <span id="playerlumber">0</span></div>
      <div class="resourceDisplay">Ore: <span id="playerore">0</span></div>
      <div class="resourceDisplay">Wheat: <span id="playerwheat">0</span></div>
      <div class="resourceDisplay">Wool: <span id="playerwool">0</span></div>
      <br>
      <button class="deckButton" id="roadB">Road</button>
      <button class="deckButton" id="settlementB">Settlement</button>
      <button class="deckButton" id="cityB">City</button>
      <button class="deckButton" id="devCardB">Dev Card</button>
    </div>

    <!-- Load external script -->
    <script is:inline src="/scripts/catan-counter.js"></script>
  </body>
</html>