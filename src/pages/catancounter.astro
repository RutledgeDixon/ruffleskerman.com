---
// Catan Card Counter - Converted to Astro
---

<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Catan Card Counter</title>
    <!-- Stylesheet -->
    <style>
        body {
            background-color: #464648;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            margin: 0;
            font-family: 'Exo 2', sans-serif;
        }

        #theHideDiv {
            position: absolute;
            z-index: 2;
            height: 100%;
            width: 100%;
            display: none;
            margin-left: -20px;
            margin-top: -35px;
        }

        #theDiv {
            position: absolute;
            z-index: 3;
            top:-60%;
            width: 50%;
            left: 25%;
            padding: 2%;
            background: #464647;
            color: white;
            border-radius: 20px;
            box-shadow: 0px 0px 20px 1px black;
            text-align: center;
            transition: 0.5s;
        }

        #theDiv input {
            text-align: center;
            background: none;
            color: white;
            width: 30%;
            height: 20%;
            border: 2px solid steelblue;
            outline: none;
            margin-bottom: 15px;
            font-size: 2rem;
            border-radius: 30px;
            transition: 0.2s;
        }

        #theDiv input:hover {
            background: steelblue;
        }

        #theDiv input::-webkit-outer-spin-button,
        #theDiv input::-webkit-inner-spin-button {
            display: none;
        }

        #theDiv button {
            display: block;
            margin: auto;
            text-align: center;
            background: none;
            color: white;
            width: 30%;
            height: 20%;
            border: 2px solid steelblue;
            outline: none;
            font-size: 2rem;
            border-radius: 30px;
            transition: 0.2s;
        }

        #theDiv button:hover {
            background: steelblue;
        }

        #catanHeader {
            float: left;
        }

        h1.header {
            text-align: center;
            color: white;
            font-size: 3.5rem;
        }

        #numButton {
            background:  #464647;
            color: white;
            font-size: 0.5em;
            padding: 10px;
            border: 2px solid steelblue;
            border-radius: 15px;
            margin: auto;
            transition: 0.2s;
            float: right;
            outline: none;
        }

        #numButton:hover {
            background: steelblue;
            border: 2px solid steelblue;
        }

        #numButton::-moz-focus-inner {
            border: 0;
        }

        div.diceDiv {
            padding-bottom: 170px;
        }

        div.dice {
            background: white;
            color: #464648;
            float: left;
            width: 9%;
            padding-top: 2%;
            padding-bottom: 2%;
            margin-right: 1.1%;
            border-radius: 20px;
            text-align: center;
            font-family: 'Exo 2', sans-serif;
            font-size: 3rem;
            font-weight: 800;
            transition: 0.2s;
        }

        div#dice12 {
            margin-right: 0%;
        }

        div.dice:hover {
            color: steelblue;
            box-shadow: 0px 0px 10px 1px steelblue;
        }

        #cardSettings {
            background: steelblue;
            height: 30%;
            width: 35%;
            float: right;
            text-align: center;
            padding: 10px;
            margin-bottom: 20px;
        }

        #cardSettingsHeader {
            float: center;
            color: white;
        }

        div.player {
            border: none;
            border-radius: 20px;
            padding: 15px;
            text-align: center;
            margin-bottom: 20px;
            background-color: white;
        }

        div#playerHands h1 {
            color: white;
        }

        .hiddendisplay {
            border-top: 1px solid black;
            padding-top: 5px;
            height: 0px;
            transition: 0.2s;
            opacity: 0;
        }

        .addingButton {
            display: none;
        }

        .hiddendisplay div.diceNums {
            display: none;
        }

        .diceNums {
            border-top: 1px solid black;
        }

        .diceNums div.diceNum {
            display: none;
        }

        .player:hover div.hiddendisplay {
            height: auto;
            opacity: 1;
        }

        .player:hover .addingButton {
            display: inline-block;
        }

        .player:hover .hiddendisplay div.diceNums {
            display: block;
        }

        .player:hover .diceNums div.diceNum {
            display: block;
        }

        .showDisplay {
            display: block !important;
            height: auto !important;
            opacity: 1 !important;
        }

        .showNums {
            display: block !important;
        }

        .showButtons {
            display: inline-block !important;
        }

        div#playerHands {
            float: left;
            width: 60%;
            text-align: center;
        }

        .topBorder {
            border-top: 1px solid black;
            padding-top: 5px;
        }

        div.buying {
            border: 3px solid red;
        }

        div.diceNums span.resourceNums span {
            color: black;
        }

        div.diceNums span.resourceNums span input {
            border: none;
            color: black;
            background: white;
            text-align: center;
            width: 30px;
        }

        .addingButton {
            border: none;
            padding: 5px;
            margin: 2px;
            border-radius: 10px;
            background: steelblue;
            color: white;
            transition: 0.2s;
        }

        .addingButton:hover {
            background: white;
            color: steelblue;
            border: 2px solid steelblue;
        }

        .resourceDisplay {
            font-size: 2rem;
            font-weight: 700;
            color: black;
        }

        .resourceDisplay span {
            color: steelblue;
            font-size: 1.5rem;
        }

        .deckButton {
            border: none;
            padding: 20px;
            margin: 10px;
            border-radius: 20px;
            background: steelblue;
            color: white;
            transition: 0.2s;
            font-size: 1.5rem;
        }

        .deckButton:hover {
            background: white;
            color: steelblue;
            border: 2px solid steelblue;
        }

        #p1h1,
        #p2h1,
        #p3h1,
        #p4h1,
        #p5h1,
        #p6h1 {
            color: black;
        }

        @media (max-width: 1200px) {
            div.dice {
                font-size: 2rem;
            }
            h1.header {
                font-size: 2.5rem;
            }
            #cardSettings {
                width: 100%;
                height: auto;
                float: none;
                clear: both;
            }
            div#playerHands {
                width: 100%;
                float: none;
            }
        }

        @media (max-width: 768px) {
            div.dice {
                font-size: 1.5rem;
                width: 18%;
                margin-bottom: 10px;
            }
            div.diceDiv {
                padding-bottom: 20px;
            }
            h1.header {
                font-size: 2rem;
            }
            #numButton {
                font-size: 0.4em;
                padding: 5px;
            }
        }
    </style>
  </head>
  <body>

    <div id="theHideDiv"></div>
    <div id="theDiv">
      <h1>How many people are playing? (Other than yourself, obviously)</h1>
      <input type="number" id="numPlayers" value="5" step="1">
      <button id="theButton2">Let's play!</button>
    </div>

    <h1 class="header"><a href="/" id="catanHeader"></a>Catan Card Counter<button id="numButton">Number of Players</button></h1>

    <div class="diceDiv">
      <div class="dice" id="dice2">2</div>
      <div class="dice" id="dice3">3</div>
      <div class="dice" id="dice4">4</div>
      <div class="dice" id="dice5">5</div>
      <div class="dice" id="dice6">6</div>
      <div class="dice" id="dice8">8</div>
      <div class="dice" id="dice9">9</div>
      <div class="dice" id="dice10">10</div>
      <div class="dice" id="dice11">11</div>
      <div class="dice" id="dice12">12</div>
    </div>

    <div id="cardSettings">
      <h1 id="cardSettingsHeader">Adjust Roll Effects</h1>
        <div class="player" id="p1">
            <h1 id="p1h1">Player 1</h1>
            <div class="hiddendisplay">
              <div>
                <div>
                  <button class="addingButton" id="p1brickA">+ Brick</button>
                  <button class="addingButton" id="p1brickS">- Brick</button>
                </div>
                <div>
                  <button class="addingButton" id="p1lumberA">+ Lumber</button>
                  <button class="addingButton" id="p1lumberS">- Lumber</button>
                </div>
                <div>
                  <button class="addingButton" id="p1oreA">+ Ore</button>
                  <button class="addingButton" id="p1oreS">- Ore</button>
                </div>
                <div>
                  <button class="addingButton" id="p1wheatA">+ Wheat</button>
                  <button class="addingButton" id="p1wheatS">- Wheat</button>
                </div>
                <div>
                  <button class="addingButton" id="p1woolA">+ Wool</button>
                  <button class="addingButton" id="p1woolS">- Wool</button>
                </div>
                <div class="topBorder">
                  <button class="addingButton" id="p1R">Road</button>
                  <button class="addingButton" id="p1S">Settlement</button>
                  <button class="addingButton" id="p1C">City</button>
                  <button class="addingButton" id="p1D">D. Card</button>
                </div>
              </div>
  
              <div class="diceNums">
                <div class="diceNum">2
                  <span class="resourceNums">:
                    <span>Brick: <input id="p1brick2" type="number" value="0" min="0"></span> | 
                    <span>Lumber: <input id="p1lumber2" type="number" value="0" min="0"></span> | 
                    <span>Ore: <input id="p1ore2" type="number" value="0" min="0"></span> | 
                    <span>Wheat: <input id="p1wheat2" type="number" value="0" min="0"></span> | 
                    <span>Wool: <input id="p1wool2" type="number" value="0" min="0"></span>
                  </span>
                </div>
                <div class="diceNum">3
