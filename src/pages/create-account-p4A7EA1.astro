---
import Layout from "../layouts/listenLayout.astro";
import "../styles/contact.css";
const title = "RK Apple Funds";
---

<Layout title={title}>
    <main class="min-h-screen py-12 px-4">
        <div class="contact-container">
            <h1 class="contact-title">RK - Apple Funds</h1>
            <p class="contact-subtitle">
                Please create an account in order to transfer funds
            </p>

            <form id="contact-form">
                <!-- Name Field -->
                <div class="form-group">
                    <label for="name" class="form-label">
                        Full Name <span class="required">*</span>
                    </label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        required
                        class="form-input"
                        placeholder="Enter your full name"
                    />
                </div>

                <!-- Email Field -->
                <div class="form-group">
                    <label for="email" class="form-label">
                        Email Address <span class="required">*</span>
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        class="form-input"
                        placeholder="your.email@example.com"
                    />
                </div>

                <!-- Phone Field -->
                <div class="form-group">
                    <label for="phone" class="form-label">
                        Phone Number <span class="required">*</span>
                    </label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        required
                        class="form-input"
                        placeholder="(555) 123-4567"
                    />
                </div>

                <!-- Company Field (Optional) -->
                <div class="form-group">
                    <label for="company" class="form-label"> Company </label>
                    <input
                        type="text"
                        id="company"
                        name="company"
                        class="form-input"
                        placeholder="Your company name"
                    />
                </div>

                <!-- Message Field (Optional) -->
                <div class="form-group">
                    <label for="message" class="form-label"> Message </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="4"
                        class="form-textarea"
                        placeholder="Why are you creating an apple funds account?"
                    ></textarea>
                </div>

                <!-- Choice Text -->
                <div class="choice-text">Choose one of the following:</div>

                <!-- Submit Buttons -->
                <div class="button-container">
                    <button
                        type="submit"
                        class="submit-button"
                        id="phone-verify-btn"
                    >
                        Verify with Phone Number
                    </button>
                    <button
                        type="submit"
                        class="submit-button"
                        id="email-verify-btn"
                    >
                        Verify with Email
                    </button>
                </div>
            </form>

            <!-- Status Message -->
            <div
                id="status-message"
                class="status-message"
                style="display: none;"
            >
                <p id="status-text"></p>
            </div>
        </div>
    </main>

    <script>
        const contactForm = document.getElementById(
            "contact-form",
        ) as HTMLFormElement;

        if (contactForm) {
            contactForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                const statusMessage = document.getElementById("status-message");
                const statusText = document.getElementById("status-text");
                const phoneBtn = document.getElementById(
                    "phone-verify-btn",
                ) as HTMLButtonElement;
                const emailBtn = document.getElementById(
                    "email-verify-btn",
                ) as HTMLButtonElement;

                // Check if elements exist
                if (!statusMessage || !statusText || !phoneBtn || !emailBtn) {
                    console.error("Required elements not found");
                    return;
                }

                // Determine which button was clicked
                const clickedButton = e.submitter as HTMLButtonElement;
                const verificationMethod =
                    clickedButton.id === "phone-verify-btn" ? "phone" : "email";

                // Show loading state
                statusMessage.style.display = "block";
                statusMessage.className = "status-message status-loading";
                statusText.textContent = "Submitting...";
                phoneBtn.disabled = true;
                emailBtn.disabled = true;
                clickedButton.textContent = "Submitting...";

                // Get form data
                const formData = new FormData(this);
                const data = {
                    name: formData.get("name") as string,
                    email: formData.get("email") as string,
                    phone: formData.get("phone") as string,
                    company: (formData.get("company") as string) || "",
                    message: (formData.get("message") as string) || "",
                    verificationMethod: verificationMethod,
                    submittedAt: new Date().toISOString(),
                };
                try {
                    const response = await fetch("/submit-contact.php", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        },
                        body: JSON.stringify(data),
                    });

                    const result = await response.json();

                    if (response.ok) {
                        console.log('Success result:', result);
                        statusMessage.className =
                            "status-message status-success";
                        statusText.textContent =
                            "Thank you! Your account has been created successfully.";
                        this.reset(); // Clear the form
                        phoneBtn.textContent = "Verify with Phone Number";
                        emailBtn.textContent = "Verify with Email";
                        phoneBtn.disabled = false;
                        emailBtn.disabled = false;
                    } else {
                        throw new Error(result.error || "Submission failed");
                    }
                } catch (error) {
                    statusMessage.className = "status-message status-error";
                    statusText.textContent =
                        "Sorry, there was an error submitting your information. Please try again.";
                    phoneBtn.textContent = "Verify with Phone Number";
                    emailBtn.textContent = "Verify with Email";
                    phoneBtn.disabled = false;
                    emailBtn.disabled = false;
                    console.error("Error:", error);
                }
            });
        }
    </script>
</Layout>
